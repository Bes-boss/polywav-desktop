{
  "name": "polywav-desktop",
  "version": "1.0.0",
  "description": "Polywav Ingest Pipeline — Electron Desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "engine:build": "cd ../polywav && ./.venv-build/Scripts/python.exe packaging/build_engine.py",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.polywav.desktop",
    "productName": "Polywav Ingest",
    "directories": {
      "output": "release"
    },
    "files": [
          "main.js",
          "preload.js",
          "app.js",
          "index.html",
          "fonts/**",
          "presets/**",
          "START-REACT-SHELL.cmd"
        ],
    "extraResources": [
          {
            "from": "../dist/polywav-engine",
            "to": "engine",
            "filter": [
              "**/*"
            ]
          },
          {
            "from": "react/dist",
            "to": "react-dist",
            "filter": [
              "**/*"
            ]
          }
        ],
    "win": {
      "target": "nsis",
      "icon": "buildres/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
